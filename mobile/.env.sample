# Variáveis do app mobile (ChegaMed).
#
# Tudo com prefixo EXPO_PUBLIC_ é embutido no bundle JS e fica legível no app
# instalado. Nunca coloque segredo real aqui — só identificadores públicos.
#
# Uso local: copie para .env e preencha.
# Uso no EAS Build: NÃO dependa do .env (ele fica de fora do tarball).
# Cadastre as variáveis nos ambientes do EAS, que os perfis de build já
# referenciam via "environment" no eas.json:
#
#   eas env:create --environment production --name EXPO_PUBLIC_BASE_URL --value "https://..."
#   eas env:create --environment production --name EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID --value "..."
#   eas env:create --environment production --name EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID --value "..."
#
# Repita para --environment preview e --environment development.

# URL base da API do ChegaMed.
EXPO_PUBLIC_BASE_URL=

# OAuth client ID do tipo "Web application" (Google Cloud Console).
# Usado nas duas plataformas para obter o idToken validado pela API.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# OAuth client ID do tipo "iOS" (Google Cloud Console).
# O iosUrlScheme no app.json é este mesmo valor com os segmentos invertidos:
# 123-abc.apps.googleusercontent.com -> com.googleusercontent.apps.123-abc
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
