# Only takes effect via Docker (see api/Dockerfile / docker-compose.yml). Running the API
# outside a container (mvn spring-boot:run, IDE run configuration) requires exporting TZ in
# the shell or passing -Duser.timezone=America/Fortaleza directly to the JVM.
TZ=America/Fortaleza

DB_URL=
DB_USERNAME=
DB_PASSWORD=
JWT_SECRET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET=
AWS_S3_PUBLIC_BASE_URL=

RESEND_API_KEY=
RESEND_FROM_EMAIL=
SUPPORT_EMAIL=

# Push notifications nativas (Expo). Deixe EXPO_ACCESS_TOKEN vazio se o projeto Expo
# não exigir "Enhanced Security for Push Notifications".
EXPO_PUSH_ENABLED=true
EXPO_ACCESS_TOKEN=

APP_LOGO_URL=
APP_WEB_URL=
DESKTOP_RESET_PASSWORD_URL=
MOBILE_RESET_PASSWORD_URL=

GEMINI_API_KEY=

OAUTH_CLIENT_ID_WEB=
OAUTH_CLIENT_ID_MOBILE=
OAUTH_CLIENT_ID_DESKTOP=
OAUTH_CLIENT_SECRET=

# Bundle id do app iOS, usado como audience ao validar o identity token do Sign in with Apple.
# Deixe vazio para usar o padrão (com.devluan.chegamed).
APPLE_BUNDLE_ID=